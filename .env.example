# Kiyotaka API (opcional — sin key, el heatmap queda deshabilitado)
KIYOTAKA_API_KEY=

# API de notificaciones (alertas salientes)
NOTIFY_API_URL=
NOTIFY_API_KEY=
# Header de auth: usar {key} como placeholder. Default: Authorization: Bearer {key}
NOTIFY_AUTH_HEADER=

# Bot de comandos Telegram (gestionar alertas escribiéndole al bot)
# Crear uno con @BotFather → TELEGRAM_BOT_TOKEN; tu chat id con /start al bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
